# ==============================================================================
# ShopSmart — Root Master Environment & Secret Configuration Template
# Copy this file to .env and fill in real values. Never commit real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Cloud & EC2 Infrastructure
# ------------------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCOUNT_ID="your_aws_account_id"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_SESSION_TOKEN="your_aws_session_token"

# EC2 Instance Details
AWS_EC2_INSTANCE_ID="i-your_instance_id"
AWS_EC2_HOST="your_ec2_public_ip"
AWS_EC2_USER="ubuntu"
AWS_EC2_KEY_NAME="vockey"
AWS_EC2_SECURITY_GROUP_ID=""

# Legacy Aliases (Supported for backward compatibility with older scripts)
INSTANCE_ID="i-your_instance_id"
REGION="us-east-1"
KEY_NAME="vockey"
EC2_HOST="your_ec2_public_ip"
EC2_USER="ubuntu"
EC2_SECURITY_GROUP_ID=""

# EC2 Private SSH Key
AWS_EC2_SSH_KEY="-----BEGIN RSA PRIVATE KEY-----
your_rsa_private_key_placeholder
-----END RSA PRIVATE KEY-----"
EC2_SSH_KEY="-----BEGIN RSA PRIVATE KEY-----
your_rsa_private_key_placeholder
-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 2. Database & Redis Connections
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/shopsmart_dev?sslmode=require"
TEST_DATABASE_URL="postgresql://user:password@host/shopsmart_test?sslmode=require"
REDIS_LOCAL_URL="redis://localhost:6379"
REDIS_SERVER_URL="redis://user:pass@host:6379"

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Secrets (min 32 chars each)
# ------------------------------------------------------------------------------
JWT_SECRET="jwt_master_secret_placeholder_min_32_chars_long"
JWT_ACCESS_SECRET="jwt_access_secret_placeholder_min_32_chars_long"
JWT_REFRESH_SECRET="jwt_refresh_secret_placeholder_min_32_chars_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS="12"

# ------------------------------------------------------------------------------
# 4. Payment Gateways (Razorpay Test / Production)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_placeholder"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# ------------------------------------------------------------------------------
# 5. Transactional Email (Gmail SMTP / Brevo / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="ShopSmart <your_email@gmail.com>"

# ------------------------------------------------------------------------------
# 6. Container Registry (DockerHub)
# ------------------------------------------------------------------------------
DOCKERHUB_USERNAME="your_dockerhub_username"
DOCKERHUB_PASSWORD="your_dockerhub_password"

# ------------------------------------------------------------------------------
# 7. Application Ports & Local Domains
# ------------------------------------------------------------------------------
SERVER_PORT="5001"
FRONTEND_PORT="3000"
FRONTEND_LOCAL_URL="http://localhost:3000"
BACKEND_LOCAL_URL="http://localhost:5001"
FRONTEND_SERVER_URL="https://your-frontend-domain.com"
BACKEND_SERVER_URL="https://your-backend-domain.com"

# ------------------------------------------------------------------------------
# 8. WhatsApp Provider (WAHA Docker Engine)
# ------------------------------------------------------------------------------
WAHA_PORT="6969"
WAHA_LOCAL_API_URL="http://localhost:6969"
WAHA_HOSTED_API_URL="https://your-waha-service.onrender.com"
WAHA_API_KEY="your_waha_api_key_placeholder"
WAHA_SESSION="default"
WAHA_DASHBOARD_USERNAME="admin"
WAHA_DASHBOARD_PASSWORD="your_secure_waha_password"
WAHA_TIMEOUT_MS="10000"

# ------------------------------------------------------------------------------
# 9. SMS Gateway (InfiniReach / Android Relay / SMSGate)
# ------------------------------------------------------------------------------
SMS_GATEWAY_URL="https://api.infinireach.io/api/v1/messages"
SMS_GATEWAY_API_KEY="your_sms_gateway_api_key_placeholder"
SMS_GATEWAY_SENDER_PHONE="+91XXXXXXXXXX"
SMS_GATEWAY_TIMEOUT_MS="30000"
SMS_GATEWAY_USER=""
SMS_GATEWAY_PASSWORD=""

# ------------------------------------------------------------------------------
# 10. Test Target Configuration
# ------------------------------------------------------------------------------
TEST_TARGET_PHONE="+91XXXXXXXXXX"
