# ------------------------------------------------------------------------------
# SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to apps/server/.env and fill in real values. Never commit real credentials.
# ------------------------------------------------------------------------------

# [REQUIRED] Node Environment. Must be one of: development, test, production
NODE_ENV=development
VITEST=false

# [OPTIONAL] Application port (Default: 5001)
PORT=5001
SERVER_PORT=5001

# [REQUIRED] The main development/production database connection string
DATABASE_URL=postgresql://user:password@host/dev_db

# [OPTIONAL] Dedicated test database. DO NOT equal DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@host/test_db

# [OPTIONAL] Local Redis connection string (Default: redis://localhost:6379)
REDIS_LOCAL_URL=redis://localhost:6379

# [OPTIONAL] Production Redis connection string
REDIS_SERVER_URL=redis://user:pass@host:port

# [OPTIONAL] Redis Cache TTL in seconds (Default: 3600 = 1 hour)
REDIS_CACHE_TTL_SECONDS=3600

# [REQUIRED] Secret for signing Access JWTs (min 32 chars)
JWT_ACCESS_SECRET=access_secret_placeholder_min_32_chars_long

# [REQUIRED] Secret for signing Refresh JWTs (min 32 chars)
JWT_REFRESH_SECRET=refresh_secret_placeholder_min_32_chars_long

# [OPTIONAL] Access JWT Expiration (Default: 15m)
JWT_ACCESS_EXPIRES_IN=15m

# [OPTIONAL] Refresh JWT Expiration (Default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# [OPTIONAL] Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=15
HEALTHCHECK_RATE_LIMIT_WINDOW_MS=60000
HEALTHCHECK_RATE_LIMIT_MAX=60

# [OPTIONAL] Currency & Transaction Settings
DEFAULT_CURRENCY=INR
CHECKOUT_TX_TIMEOUT_MS=45000
CHECKOUT_TX_MAX_WAIT_MS=20000

# [REQUIRED] Razorpay API Key ID
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# [REQUIRED] Razorpay API Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_secret_placeholder

# [REQUIRED] Razorpay Webhook Secret for payload validation
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_placeholder

# [OPTIONAL] SMTP Email Configuration (Free options: Gmail App Password, Brevo, Resend)
# Leave blank to use local JSON logging transport fallback.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="ShopSmart <your_email@gmail.com>"

# [OPTIONAL] Bcrypt salt rounds (Default: 12)
BCRYPT_SALT_ROUNDS=12

# [OPTIONAL] Winston log level (Default: info)
LOG_LEVEL=info

# [OPTIONAL] Winston log format (Default: text)
LOG_FORMAT=text

# [OPTIONAL] Frontend URLs
FRONTEND_LOCAL_URL=http://localhost:3000
FRONTEND_SERVER_URL=https://your-frontend-domain.com

# [OPTIONAL] Backend URLs
BACKEND_LOCAL_URL=http://localhost:5001
BACKEND_SERVER_URL=https://your-backend-domain.com

# [OPTIONAL] WhatsApp Provider (WAHA - WhatsApp HTTP API Docker Service)
WAHA_PORT=6969
WAHA_LOCAL_API_URL=http://localhost:6969
WAHA_HOSTED_API_URL=https://your-waha-service.onrender.com
WAHA_API_KEY=your_waha_api_key_placeholder
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_secure_waha_password
WAHA_TIMEOUT_MS=10000

# [OPTIONAL] SMS Gateway (InfiniReach / Android Relay / SMSGate)
# Provider 1: InfiniReach Cloud API (https://app.infinireach.io)
SMS_GATEWAY_URL=https://api.infinireach.io/api/v1/messages
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_placeholder
SMS_GATEWAY_SENDER_PHONE=+91XXXXXXXXXX
SMS_GATEWAY_TIMEOUT_MS=30000

# Provider 2: SMSGate Android App (Username/Password Basic Auth)
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

# [OPTIONAL] Test target phone number for live verification tests
TEST_TARGET_PHONE=+91XXXXXXXXXX
